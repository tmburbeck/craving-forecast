@page "/reset-password"
@inject Api Api

<PageTitle>Choose a new password · Salus</PageTitle>
<div class="narrow stack" style="--gap:22px">
    <Brand />
    @if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Code))
    {
        <div class="stack" style="--gap:8px">
            <h1 class="heading">This link isn't complete</h1>
            <p class="body">Open the link from your email again, or ask for a new one.</p>
        </div>
        <a class="btn btn-primary" href="forgot">Get a new link</a>
    }
    else if (_done)
    {
        <div class="stack" style="--gap:8px" role="status">
            <h1 class="heading">Password changed</h1>
            <p class="body">Sign in with your new password.</p>
        </div>
        <a class="btn btn-primary" href="signin">Sign in</a>
    }
    else
    {
        <div class="stack" style="--gap:8px">
            <h1 class="heading">Choose a new password</h1>
            <p class="body">For <b>@Email</b>.</p>
        </div>
        <form class="stack" style="--gap:18px" @onsubmit="Save" novalidate>
            <input type="email" autocomplete="username" value="@Email" hidden readonly aria-hidden="true" />
            <div class="field">
                <label for="password">New password</label>
                <input id="password" type="password" autocomplete="new-password" @bind="_password" placeholder="At least 10 characters"
                       required minlength="10" aria-describedby="password-hint" />
                <span id="password-hint" class="tiny muted">At least 10 characters. A short phrase is easy to remember.</span>
            </div>
            @if (_error is not null) { <p class="error" role="alert">@_error</p> }
            <button class="btn btn-primary" type="submit" disabled="@_busy">@(_busy ? "Saving…" : "Save new password")</button>
        </form>
        @if (_expired) { <a class="btn btn-plain" href="forgot">Get a new link</a> }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "code")] public string? Code { get; set; }

    private string _password = "";
    private string? _error;
    private bool _busy;
    private bool _done;
    private bool _expired;

    private async Task Save()
    {
        if (_busy) return;
        if (_password.Length < 10) { _error = "Use at least 10 characters."; return; }
        _busy = true;
        _error = null;
        try
        {
            _error = await Api.ResetPasswordAsync(Email!, Code!, _password);
            _expired = _error?.Contains("expired") == true;
            if (_error is null) { _done = true; _password = ""; }
        }
        catch (Exception) { _error = "Couldn't reach Salus. Check your connection and try again."; }
        finally { _busy = false; }
    }
}
