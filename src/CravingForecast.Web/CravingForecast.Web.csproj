<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CravingForecast.Web</RootNamespace>
    <!-- index.html names blazor.webassembly.js directly: the build-time placeholders aren't filled in when the API publishes this app. -->
    <!-- Loaded by phones too: let the time zone and culture data come from the browser. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CravingForecast.Core\CravingForecast.Core.csproj" />
  </ItemGroup>

</Project>
