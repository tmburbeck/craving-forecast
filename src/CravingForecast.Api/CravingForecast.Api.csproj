<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CravingForecast.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" PrivateAssets="all" />
    <!-- Current Web Push standard (RFC 8291 aes128gcm + RFC 8292 VAPID), which Apple's push service requires. -->
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <PackageReference Include="Azure.Communication.Email" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CravingForecast.Core\CravingForecast.Core.csproj" />
    <!-- The web app is served by this API, from the same address. Only its files (wwwroot, _framework) are
         needed, not its assembly: a second *.runtimeconfig.json in the output stops App Service from knowing
         which program to start, and it falls back to its placeholder site. -->
    <ProjectReference Include="..\CravingForecast.Web\CravingForecast.Web.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CravingForecast.Tests" />
  </ItemGroup>

  <!-- App Service starts whichever program has a *.runtimeconfig.json in the output; the web app's copy
       (which it doesn't use, its settings ship inside _framework) would leave two to choose from. -->
  <Target Name="RemoveWebAppRuntimeConfig" AfterTargets="Publish">
    <Delete Files="$(PublishDir)CravingForecast.Web.runtimeconfig.json" />
  </Target>

</Project>
